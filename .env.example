# App
NODE_ENV=development
APP_NAME=vethealth
APP_PORT=5000
API_PREFIX=api
APP_FALLBACK_LANGUAGE=en
APP_HEADER_LANGUAGE=x-custom-lang
FRONTEND_DOMAIN=http://localhost:3000
BACKEND_DOMAIN=http://localhost:5000
PLATFORM=linux/amd64

# Admin (seed user)
ADMIN_NAME=Admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=changeme

# Auth (JWT)
AUTH_JWT_SECRET=replace-with-strong-secret
AUTH_JWT_TOKEN_EXPIRES_IN=15m
AUTH_REFRESH_SECRET=replace-with-strong-refresh-secret
AUTH_REFRESH_TOKEN_EXPIRES_IN=7d

# Database
# Either provide DATABASE_URL or the individual DATABASE_* values below.
# DATABASE_URL=postgres://user:password@localhost:5432/vethealth
DATABASE_TYPE=postgres
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_USERNAME=postgres
DATABASE_PASSWORD=postgres
DATABASE_NAME=vethealth
DATABASE_SYNCHRONIZE=false
DATABASE_MAX_CONNECTIONS=100
DATABASE_SSL_ENABLED=false
DATABASE_REJECT_UNAUTHORIZED=false
DATABASE_CA=
DATABASE_KEY=
DATABASE_CERT=

# Mail
MAIL_HOST=smtp.example.com
MAIL_PORT=465
MAIL_CLIENT_PORT=8025
MAIL_USER=
MAIL_PASSWORD=
MAIL_DEFAULT_EMAIL=no-reply@example.com
MAIL_DEFAULT_NAME=VetHealth
MAIL_IGNORE_TLS=false
MAIL_SECURE=true
MAIL_REQUIRE_TLS=false
REJECT_UNAUTHORIZED=false

# File storage
# Driver: local | s3 | r2 | seaweed
FILE_STORAGE_DRIVER=local
FILE_MAX_SIZE=5242880

# S3 / R2 / Seaweed (required when FILE_STORAGE_DRIVER is not "local")
FILE_S3_ENDPOINT=
FILE_S3_BUCKET=
FILE_S3_REGION=
FILE_S3_ACCESS_KEY=
FILE_S3_SECRET_KEY=
FILE_S3_FORCE_PATH_STYLE=false
# One of FILE_S3_PUBLIC_URL or FILE_CDN_BASE_URL is required for non-local storage.
FILE_S3_PUBLIC_URL=
FILE_CDN_BASE_URL=
FILE_CDN_INCLUDE_BUCKET_IN_PATH=false
